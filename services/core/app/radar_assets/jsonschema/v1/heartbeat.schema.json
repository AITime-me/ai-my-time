{
  "$defs": {
    "RadarConnectionStatus": {
      "enum": [
        "connected",
        "disconnected",
        "degraded"
      ],
      "title": "RadarConnectionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applied_manifest_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Applied Manifest Version",
      "type": "string"
    },
    "connection_status": {
      "$ref": "#/$defs/RadarConnectionStatus"
    },
    "heartbeat_at": {
      "format": "date-time",
      "title": "Heartbeat At",
      "type": "string"
    },
    "journal_backlog_count": {
      "maximum": 10000000,
      "minimum": 0,
      "title": "Journal Backlog Count",
      "type": "integer"
    },
    "reader_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reader Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status_detail": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Detail"
    },
    "telegram_authorized": {
      "title": "Telegram Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "reader_id",
    "applied_manifest_version",
    "heartbeat_at",
    "connection_status",
    "telegram_authorized",
    "journal_backlog_count"
  ],
  "title": "RadarHeartbeatV1",
  "type": "object"
}
