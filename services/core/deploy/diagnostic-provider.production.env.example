# Contract only — do not put a real credential into this file or the repository.
# Enabling this provider requires a separately approved, read-only secret mount.
APP_ENV=production
DIAGNOSTIC_PROVIDER=yandex_production
YANDEX_PRODUCTION_FOLDER_ID=<production-folder-id>
YANDEX_PRODUCTION_API_KEY_PATH=/run/secrets/yandex_production_api_key
YANDEX_PRODUCTION_MODEL=yandexgpt/latest
